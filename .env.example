# ---------- 累计访问悬浮框 ----------
# 关闭
VITE_VISITOR_COUNTER_DISABLED=true

# 方式 A（推荐国内/不可直连外网时）：自建「+1 并返回数字」的接口，填完整 URL（GET）
# 浏览器会请求该地址；你可让 Nginx 反代到任意后端，或 Cloudflare Worker / 云函数返回 JSON：
# { "value": 123 } 或 { "count": 123 } 或 { "visits": 123 } 或 { "total": 123 }
# VITE_VISITOR_COUNTER_CUSTOM_URL=https://你的域名/api/visit-hit

# 方式 B：直连 CountAPI（需客户端能访问 api.countapi.xyz）
VITE_VISITOR_COUNTER_NS=ywrn-wetland-youth
VITE_VISITOR_COUNTER_KEY=site-hits
